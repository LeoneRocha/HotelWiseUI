{
  "name": "hotelwise",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "run": "vite",
    "build": "npm run version:ui && node ./node_modules/typescript7/bin/tsc -b && vite build",
    "build:dev": "npm run version:ui && node ./node_modules/typescript7/bin/tsc -b && vite build --mode development",
    "build:prod": "npm run version:ui && node ./node_modules/typescript7/bin/tsc -b && vite build --mode production",
    "build:release": "npm run build:prod",
    "version:ui": "node ./scripts/bump-ui-version.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.19.0",
    "@azure/msal-react": "^5.6.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@popperjs/core": "^2.11.8",
    "axios": "^1.19.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.4.14",
    "jwt-decode": "^4.0.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.3",
    "re-resizable": "^6.11.2",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-date-picker": "^12.1.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.8",
    "react-draggable": "^4.7.1",
    "react-icons": "^5.7.0",
    "react-router": "^8.3.0",
    "react-toastify": "^11.1.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-environment": "^1.1.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "nanoid": "^3.3.18"
  }
}
